{
  "name": "@eda-labs/topo-builder",
  "type": "module",
  "version": "0.2.3",
  "description": "EDA Topology Builder app and reusable React library.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eda-labs/topo-builder.git"
  },
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./styles.css": {
      "types": "./dist/lib/styles.css.d.ts",
      "default": "./dist/lib/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate:types": "npx ts-node scripts/generate-schema-types.ts",
    "dev": "astro dev",
    "build": "astro build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/write-style-css-type.mjs",
    "build:all": "npm run build:lib",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint src/ && jscpd src/",
    "lint:fix": "eslint src/ --fix",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:e2e:ui:remote": "npx playwright test --config playwright.config.ts --ui --ui-host=0.0.0.0 --ui-port=8080",
    "test:e2e:debug": "playwright test --config playwright.config.ts --debug",
    "cpd": "jscpd src/"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "ajv": "^8.20.0",
    "bezier-js": "^6.1.4",
    "fastest-levenshtein": "^1.0.16",
    "js-yaml": "^4.2.0",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@xyflow/react": "^12.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/react": "^5.0.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bezier-js": "^4.1.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@xyflow/react": "^12.11.0",
    "astro": "^6.4.6",
    "eslint": "^10.4.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.6.0",
    "jscpd": "^5.0.8",
    "json-schema-to-typescript": "^15.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.5"
  },
  "overrides": {
    "dompurify": "3.4.10"
  }
}
